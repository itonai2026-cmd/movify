# ═══════════════════════════════════════════════════════════════════════════
# Movify – Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values.
# Never commit .env to version control!
#
# ═══════════════════════════════════════════════════════════════════════════

# ── Application Settings ─────────────────────────────────────────────────────
APP_ENV=development
# development | production
# Set to 'production' to hide error messages and enable strict security

APP_URL=http://localhost
# Your application URL (without trailing slash)
# Examples: http://localhost, https://movify.example.com

BASE_PATH=/wp/movify
# URL path to your application
# Use '' (empty) if at domain root, or '/movify' if in /var/www/html/movify

# ── Database Configuration ───────────────────────────────────────────────────
DB_HOST=localhost
# MySQL/MariaDB hostname
# Your setup: r133813iton.cd.cpanel.net (or local hostname)

DB_NAME=ai_video_generator
# Database name
# Your setup: r133813iton_ai_video

DB_USER=root
# Database username
# Your setup: r133813iton_dacos

DB_PASS=
# Database password
# Your setup: Azor&?2026?! (stored in environment, never in code)

# ── SMTP Email Configuration ─────────────────────────────────────────────────
#
# IMPORTANT: Email verification will NOT work if SMTP is not configured!
# Fill in all SMTP_* values to enable email sending.
#
# Dev Mode: Leave SMTP_USER and SMTP_PASS empty to see codes in logs/browser

SMTP_HOST=smtp.gmail.com
# SMTP server hostname
#
# Common providers:
#   Gmail:       smtp.gmail.com
#   Mailgun:     smtp.mailgun.org
#   SendGrid:    smtp.sendgrid.net
#   Outlook:     smtp-mail.outlook.com
#   Custom:      mail.yourserver.com

SMTP_PORT=587
# SMTP port
#   587  = TLS (StartTLS) – recommended
#   465  = SSL (implicit TLS)
#   25   = Plain (unencrypted) – not recommended

SMTP_USER=your@gmail.com
# SMTP username/email
#
# For Gmail: Use your Gmail address
# IMPORTANT: Generate an App Password:
#   1. Go to https://myaccount.google.com/apppasswords
#   2. Select "Mail" and "Windows Computer" (or your device)
#   3. Copy the 16-character password
#   4. Paste it in SMTP_PASS below

SMTP_PASS=your_app_password_here
# SMTP password
#
# For Gmail: Use the 16-character App Password (NOT your regular password)
# For other providers: Use your account password or API key

SMTP_FROM=noreply@movify.app
# Sender email address
# This is the "From" email shown in verification and password reset emails

# SMTP_FROM_NAME is hardcoded in config.php as 'Movify'

# ── AI Video Generation (Fal.ai) ─────────────────────────────────────────────
FAL_AI_API_KEY=your_fal_ai_key_here
# Your Fal.ai API key for video generation
#
# Get it from: https://fal.ai (create account → API keys)
# This key enables video generation via AI models (Wan, LTX, Kling)

# ═══════════════════════════════════════════════════════════════════════════
# Quick Setup Guide
# ═══════════════════════════════════════════════════════════════════════════
#
# 1. MySQL/MariaDB Setup:
#    - Create database: CREATE DATABASE ai_video_generator;
#    - Run: mysql -u root ai_video_generator < database/schema.sql
#
# 2. Gmail SMTP (Recommended for testing):
#    - Go to https://myaccount.google.com
#    - Search for "App passwords"
#    - Create new password for "Mail" + "Windows Computer"
#    - Copy 16-character password to SMTP_PASS
#    - Set SMTP_USER to your Gmail address
#
# 3. Fal.ai Setup:
#    - Register at https://fal.ai
#    - Create API key in dashboard
#    - Paste key to FAL_AI_API_KEY
#
# 4. For production, use environment variables:
#    export DB_HOST=production-db.example.com
#    export SMTP_USER=support@yourcompany.com
#    export FAL_AI_API_KEY=prod_key_123
#
# ═══════════════════════════════════════════════════════════════════════════
